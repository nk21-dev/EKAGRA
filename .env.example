# EKAGRA Environment Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=your_strong_jwt_secret_min_32_chars_here

# Database Configuration (Local SQLite vs Turso Cloud LibSQL)
DB_PATH=./data/ekagra.sqlite
# Set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN to enable Turso Cloud SQLite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email / SMTP Configuration (Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_here
EMAIL_FROM="EKAGRA Security <onboarding@resend.dev>"

# AI Duration Estimation Configuration (Google Gemini)
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_ENABLED=false
GEMINI_API_KEY=
# Encryption secret for storing user AI API keys (AES-256-GCM)
AI_KEY_ENCRYPTION_SECRET=your_strong_encryption_secret_min_32_chars_here
AI_ENCRYPTION_SECRET=your_strong_encryption_secret_min_32_chars_here
AI_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_INTERACTIVE_TIMEOUT_MS=15000
